#!/usr/bin/env bash

# Midtrain stage 1: 16K sequence length, initialized from the pretrain handoff.
source "$(dirname -- "${BASH_SOURCE[0]}")/../base.env"

export EXP_NAME=zgcm7b_midtrain_seq16k_tp2cp2_gbs768_180b
export PRETRAINED_CHECKPOINT="${PRETRAIN_FINAL_CHECKPOINT:-${TRAIN_ROOT}/handoff/zgcm7b_pretrain_final}"

# Stage geometry and token budget.
export TP_SIZE=2
export PP_SIZE=1
export CP_SIZE=2
export CP_COMM_TYPE=a2a
export MICRO_BATCH_SIZE=2
export GLOBAL_BATCH_SIZE=768
export SEQ_LENGTH=16384
export MAX_POSITION_EMBEDDINGS=16384
export ROTARY_BASE=5000000
export TRAIN_SAMPLES=10986240
export LR_WARMUP_SAMPLES=109824
export LR_DECAY_SAMPLES=10986240
export ENABLE_RECOMPUTE=0
export RECOMPUTE_GRANULARITY=""
export RECOMPUTE_METHOD=""
export RECOMPUTE_NUM_LAYERS=""
export CROSS_ENTROPY_FUSION_IMPL=""

export OUTPUT_ROOT="${MIDTRAIN_SEQ16K_OUTPUT_ROOT:-${TRAIN_ROOT}/results/${EXP_NAME}}"
export SAVE_CHECKPOINT_DIR="${MIDTRAIN_SEQ16K_SAVE_CHECKPOINT_DIR:-${OUTPUT_ROOT}/checkpoints}"
export LOAD_CHECKPOINT_DIR="${MIDTRAIN_SEQ16K_LOAD_CHECKPOINT_DIR:-${SAVE_CHECKPOINT_DIR}}"
export TENSORBOARD_DIR="${MIDTRAIN_SEQ16K_TENSORBOARD_DIR:-${OUTPUT_ROOT}/tensorboard}"
export DATA_CACHE_DIR="${MIDTRAIN_SEQ16K_DATA_CACHE_DIR:-${OUTPUT_ROOT}/data-cache}"
