#!/usr/bin/env bash

# Midtrain stage 2: 64K sequence length, continued from stage 1 with context
# parallelism widened to 4 and selective activation recomputation.
source "$(dirname -- "${BASH_SOURCE[0]}")/../base.env"

export EXP_NAME=zgcm7b_midtrain_seq64k_tp2cp4_gbs192_240b
export PRETRAINED_CHECKPOINT="${MIDTRAIN_SEQ16K_CHECKPOINT:-${TRAIN_ROOT}/results/zgcm7b_midtrain_seq16k_tp2cp2_gbs768_180b/checkpoints}"

# Stage geometry and token budget.
export TP_SIZE=2
export PP_SIZE=1
export CP_SIZE=4
export CP_COMM_TYPE=a2a
export MICRO_BATCH_SIZE=1
export GLOBAL_BATCH_SIZE=192
export SEQ_LENGTH=65536
export MAX_POSITION_EMBEDDINGS=65536
export ROTARY_BASE=5000000
export TRAIN_SAMPLES=3662016
export LR_WARMUP_SAMPLES=36672
export LR_DECAY_SAMPLES=3662016
export ENABLE_RECOMPUTE=1
export RECOMPUTE_GRANULARITY="selective"
export RECOMPUTE_METHOD=""
export RECOMPUTE_NUM_LAYERS=""
export CROSS_ENTROPY_FUSION_IMPL="te"

export OUTPUT_ROOT="${MIDTRAIN_SEQ64K_OUTPUT_ROOT:-${TRAIN_ROOT}/results/${EXP_NAME}}"
export SAVE_CHECKPOINT_DIR="${MIDTRAIN_SEQ64K_SAVE_CHECKPOINT_DIR:-${OUTPUT_ROOT}/checkpoints}"
export LOAD_CHECKPOINT_DIR="${MIDTRAIN_SEQ64K_LOAD_CHECKPOINT_DIR:-${SAVE_CHECKPOINT_DIR}}"
export TENSORBOARD_DIR="${MIDTRAIN_SEQ64K_TENSORBOARD_DIR:-${OUTPUT_ROOT}/tensorboard}"
export DATA_CACHE_DIR="${MIDTRAIN_SEQ64K_DATA_CACHE_DIR:-${OUTPUT_ROOT}/data-cache}"
