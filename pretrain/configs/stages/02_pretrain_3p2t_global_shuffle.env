#!/usr/bin/env bash

# Phase 2 of pretraining: 3.2T more tokens, resumed from the phase-1 final
# checkpoint with the corpus globally shuffled offline.
source "$(dirname -- "${BASH_SOURCE[0]}")/../base.env"

export EXP_NAME=zgcm7b_pretrain_3p2t_global_shuffle
export REAL_DATA_PREFIX="${PRETRAIN_3P2T_DATA_PREFIX:-${SHARED_STORAGE_ROOT}/datasets/zgcm7b/pretrain_3p2t_global_shuffle_text_document}"
export REQUIRE_LOAD_CHECKPOINT=1
export OVERRIDE_OPT_PARAM_SCHEDULER=1

# This corpus was globally shuffled during offline materialization. Preserve
# that recorded order in the loader so resume offsets map to the same samples.
export NO_DATA_SHUFFLE=1

# Geometry and 3.2T schedule.
export TP_SIZE=2
export PP_SIZE=1
export CP_SIZE=2
export CP_COMM_TYPE=a2a
export MICRO_BATCH_SIZE=2
export GLOBAL_BATCH_SIZE=768
export SEQ_LENGTH=16384
export MAX_POSITION_EMBEDDINGS=16384
export TRAIN_ITERS=333787
export LR_WARMUP_ITERS=667

# Provenance for the offline shuffle; the runtime loader does not reshuffle.
export GLOBAL_SHUFFLE_SEED=20260603

# Resume point: phase 1 ends at iteration 79473 (79473 * 768 samples).
export RESUME_ITER=79473
export RESUME_CONSUMED_SAMPLES=61035264
export MEGATRON_DATASET_SAMPLE_OFFSET=61035264

export OUTPUT_ROOT="${PRETRAIN_3P2T_OUTPUT_ROOT:-${TRAIN_ROOT}/results/${EXP_NAME}}"
export SAVE_CHECKPOINT_DIR="${PRETRAIN_3P2T_SAVE_CHECKPOINT_DIR:-${OUTPUT_ROOT}/checkpoints}"
export LOAD_CHECKPOINT_DIR="${PRETRAIN_1T_FINAL_CHECKPOINT:-${TRAIN_ROOT}/results/zgcm7b_pretrain_1t_sequential/checkpoints}"
export TENSORBOARD_DIR="${PRETRAIN_3P2T_TENSORBOARD_DIR:-${OUTPUT_ROOT}/tensorboard}"
export DATA_CACHE_DIR="${PRETRAIN_3P2T_DATA_CACHE_DIR:-${OUTPUT_ROOT}/data-cache}"
