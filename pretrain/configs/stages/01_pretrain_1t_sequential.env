#!/usr/bin/env bash

# Phase 1 of pretraining: 1T tokens read sequentially from the indexed corpus.
source "$(dirname -- "${BASH_SOURCE[0]}")/../base.env"

export EXP_NAME=zgcm7b_pretrain_1t_sequential
export REAL_DATA_PREFIX="${PRETRAIN_1T_DATA_PREFIX:-${SHARED_STORAGE_ROOT}/datasets/zgcm7b/pretrain_1t_sequential_text_document}"
export REQUIRE_LOAD_CHECKPOINT=0
export OVERRIDE_OPT_PARAM_SCHEDULER=0

# Geometry and 1T sequential schedule.
export TP_SIZE=2
export PP_SIZE=1
export CP_SIZE=2
export CP_COMM_TYPE=a2a
export MICRO_BATCH_SIZE=2
export GLOBAL_BATCH_SIZE=768
export SEQ_LENGTH=16384
export MAX_POSITION_EMBEDDINGS=16384
export TRAIN_ITERS=79473
export LR_WARMUP_ITERS=667

export OUTPUT_ROOT="${PRETRAIN_1T_OUTPUT_ROOT:-${TRAIN_ROOT}/results/${EXP_NAME}}"
export SAVE_CHECKPOINT_DIR="${PRETRAIN_1T_SAVE_CHECKPOINT_DIR:-${OUTPUT_ROOT}/checkpoints}"
export LOAD_CHECKPOINT_DIR="${PRETRAIN_1T_LOAD_CHECKPOINT_DIR:-${SAVE_CHECKPOINT_DIR}}"
export TENSORBOARD_DIR="${PRETRAIN_1T_TENSORBOARD_DIR:-${OUTPUT_ROOT}/tensorboard}"
export DATA_CACHE_DIR="${PRETRAIN_1T_DATA_CACHE_DIR:-${OUTPUT_ROOT}/data-cache}"
